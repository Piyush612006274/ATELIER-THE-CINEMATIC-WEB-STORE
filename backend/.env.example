# ATELIER API environment template
# Run `npm run env:init` from the project root to create local env files and generate secrets.
# Then fill in DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD, and SMTP_USER/SMTP_PASS/EMAIL_FROM.
# Never commit backend/.env or share its contents.

DATABASE_URL=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# env:init generates strong local values for these secrets.
JWT_SECRET=
# env:init generates this stable key to encrypt AI provider API credentials stored from Admin → AI API Studio. Keep it backed up and unchanged.
AI_PROVIDER_ENCRYPTION_KEY=
COOKIE_NAME=atelier_session
ADMIN_COOKIE_NAME=atelier_admin_session
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_DOMAIN=

# env:init creates a matching random value in frontend/.env.local.
SECURITY_INTERNAL_TOKEN=
SECURITY_IP_ALLOWLIST=
# Leave empty/false for local development; set exact trusted hop count only behind a trusted proxy.
TRUST_PROXY=

# Optional payments. Add valid provider credentials only when enabling payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_QR_URL=
PAYMENT_RAZORPAY_QR_ID=
PAYMENT_UPI_ID=

# Optional WhatsApp Cloud API integration.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_TO=
WHATSAPP_TEMPLATE_NAME=atelier_order_paid
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# SMTP-only OTP delivery for registration, login, and password reset.
# Gmail: enable 2-Step Verification and create a Google App Password.
# Port 587 uses STARTTLS; port 465 uses implicit TLS and SMTP_SECURE=true.
# SMTP_USER and EMAIL_FROM should usually be the same authorized sender address.
# For Gmail App Passwords, paste the App Password without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_EHLO_NAME=atelier.local
EMAIL_FROM=
CONTACT_EMAIL=
# env:init generates a separate strong value for OTP hashing.
OTP_PEPPER=

# Image generation provider adapter: ai_horde, gemini, or openai_compatible.
# Changing this value selects code already supported by this project; arbitrary providers
# with a different API protocol need a small backend adapter, not just an env change.
IMAGE_GENERATION_PROVIDER=ai_horde

# Provider 1: AI Horde
AI_HORDE_API_KEY=
AI_HORDE_BASE_URL=https://aihorde.net/api/v2
AI_HORDE_CLIENT_AGENT=

# Provider 2: Gemini image generation (separate model from the Gemini chat model)
GEMINI_API_KEY=
LOCAL_TRYON_ENABLED=false
LOCAL_TRYON_URL=http://127.0.0.1:8789/try-on
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Provider 3: any image API that implements an OpenAI-compatible POST /images/generations endpoint
# Base URL is the API root (e.g. https://api.example.com/v1), not the final endpoint URL.
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

RAPIDAPI_KEY=
RAPIDAPI_HOST=try-on-diffusion.p.rapidapi.com
AI_TRY_ON_USER_24H_LIMIT=5
AI_TRY_ON_MONTHLY_LIMIT=100
